<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!--
      Built-in controls (Button, Entry, Picker, CheckBox and so on) are deliberately left unstyled, so they render
      as the native WinUI / macOS controls. Only layout and text helpers are defined here.
    -->

    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Margin" Value="0,12,0,4" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <Style x:Key="Muted" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
    </Style>

    <Style x:Key="WarningText" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource StrokeLight}, Dark={StaticResource StrokeDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="Banner" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFF4DE, Dark=#3D3220}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 6" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style x:Key="Thumb" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ThumbLight}, Dark={StaticResource ThumbDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 6" />
    </Style>

    <Style x:Key="TabButton" TargetType="Button">
        <Setter Property="Padding" Value="14,6" />
    </Style>

    <Style x:Key="TabButtonSelected" TargetType="Button">
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="BackgroundColor" Value="{StaticResource Pond}" />
        <Setter Property="TextColor" Value="White" />
    </Style>

    <!-- Small buttons in the description editor's toolbar -->
    <Style x:Key="EditorTool" TargetType="Button">
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="MinimumWidthRequest" Value="32" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Column headers in tables: click to sort -->
    <Style x:Key="HeaderButton" TargetType="Button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
    </Style>
</ResourceDictionary>
