<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ArtGander.App.ViewModels"
             xmlns:views="clr-namespace:ArtGander.App.Views"
             xmlns:m="clr-namespace:ArtGander.Core.Model;assembly=ArtGander.Core"
             xmlns:s="clr-namespace:ArtGander.Core.Services;assembly=ArtGander.Core"
             x:Class="ArtGander.App.Views.PieceDetailPage"
             x:Name="Root"
             x:DataType="vm:PieceDetailViewModel"
             Title="{Binding EditTitle}"
             Shell.NavBarIsVisible="False">

    <ContentPage.MenuBarItems>
        <MenuBarItem Text="File">
            <MenuFlyoutItem Text="Save" Command="{Binding SaveCommand}">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="{OnPlatform WinUI=Ctrl, MacCatalyst=Cmd}" Key="S" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Reload from Disk" Command="{Binding ReloadCommand}">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="{OnPlatform WinUI=Ctrl, MacCatalyst=Cmd}" Key="R" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Add Files…" Command="{Binding AddFilesCommand}" />
            <MenuFlyoutItem Text="Show Folder" Command="{Binding RevealFolderCommand}" />
        </MenuBarItem>
    </ContentPage.MenuBarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="24,16,24,0" RowSpacing="10">
        <Grid.GestureRecognizers>
            <DropGestureRecognizer AllowDrop="True" Drop="OnDrop" />
        </Grid.GestureRecognizers>

        <!-- Header -->
        <Grid ColumnDefinitions="96,*,Auto" ColumnSpacing="16">
            <Border Style="{StaticResource Thumb}" HeightRequest="96" WidthRequest="96">
                <Grid>
                    <Image Source="placeholder.png" Opacity="0.5" Margin="20" />
                    <Image Source="{Binding Thumbnail}" Aspect="AspectFill" />
                </Grid>
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="8">
                    <Button Text="‹ Back" Clicked="OnBackClicked" HorizontalOptions="Start" Padding="10,2" FontSize="13" />
                    <Button Text="{Binding ParentTitle, StringFormat='Part of: {0}'}" Command="{Binding OpenParentCommand}" IsVisible="{Binding HasParent}"
                            FontSize="12" Padding="8,2" />
                    <Label Text="PROJECT" IsVisible="{Binding IsProject}" FontSize="11" FontAttributes="Bold" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Pond}, Dark={StaticResource PondLight}}" />
                </HorizontalStackLayout>
                <Label Text="Title" Style="{StaticResource FieldLabel}" Margin="0" />
                <Entry Text="{Binding EditTitle}" FontSize="22" FontAttributes="Bold" Placeholder="Title" IsReadOnly="{Binding IsReadOnly}" />
                <Label Text="{Binding FolderPreview}" Style="{StaticResource WarningText}" IsVisible="{Binding FolderPreview, Converter={StaticResource HasValue}}" />
                <Label Text="{Binding FolderPath}" Style="{StaticResource Muted}" LineBreakMode="MiddleTruncation">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding RevealFolderCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
            <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                <Button Text="Show folder" Command="{Binding RevealFolderCommand}" />
                <Button Text="Reload" Command="{Binding ReloadCommand}" />
                <Button Text="Save" Command="{Binding SaveCommand}" Style="{StaticResource TabButtonSelected}" />
            </HorizontalStackLayout>
        </Grid>

        <!-- Banners -->
        <VerticalStackLayout Grid.Row="1" Spacing="6">
            <Border Style="{StaticResource Banner}" IsVisible="{Binding IsReadOnly}">
                <Label Text="{Binding ReadOnlyReason, StringFormat='Read-only: {0}'}" />
            </Border>
            <Border Style="{StaticResource Banner}" IsVisible="{Binding ChangedElsewhere}">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <Label Text="This item was changed on another computer while you were editing." VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Load their version" Command="{Binding ReloadCommand}" />
                    <Button Grid.Column="2" Text="Keep mine" Command="{Binding OverwriteCommand}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Banner}" IsVisible="{Binding LooksLikeProject}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Text="This folder contains several folders with art. Is it a project (e.g. a book) rather than a single art piece?" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Convert to project" Command="{Binding ConvertToProjectCommand}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Banner}" IsVisible="{Binding Notice, Converter={StaticResource HasValue}}">
                <Label Text="{Binding Notice}" />
            </Border>
        </VerticalStackLayout>

        <!-- Tabs -->
        <HorizontalStackLayout Grid.Row="2" Spacing="6" x:Name="Tabs">
            <Button x:Name="TabOverview" Text="Overview" Command="{Binding SelectTabCommand}" CommandParameter="overview" />
            <Button x:Name="TabPieces" Text="Pieces" Command="{Binding SelectTabCommand}" CommandParameter="pieces" IsVisible="{Binding IsProject}" />
            <Button x:Name="TabFiles" Text="Files" Command="{Binding SelectTabCommand}" CommandParameter="files" />
            <Button x:Name="TabProducts" Text="Products" Command="{Binding SelectTabCommand}" CommandParameter="products" />
            <Button x:Name="TabSales" Text="Sales" Command="{Binding SelectTabCommand}" CommandParameter="sales" />
            <Button x:Name="TabCopyright" Text="Copyright" Command="{Binding SelectTabCommand}" CommandParameter="copyright" />
        </HorizontalStackLayout>

        <!-- ============ OVERVIEW ============ -->
        <ScrollView Grid.Row="3" IsVisible="{Binding IsOverview}">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="24" Padding="0,0,0,24">
                <VerticalStackLayout>
                    <Label Text="{Binding KindLabel, StringFormat='About this {0}'}" Style="{StaticResource SectionTitle}" />
                    <Label Text="Status" Style="{StaticResource FieldLabel}" />
                    <Picker ItemsSource="{x:Static vm:PieceDetailViewModel.WorkStatuses}" SelectedItem="{Binding Piece.Status}" WidthRequest="220" HorizontalOptions="Start"
                            ItemDisplayBinding="{Binding ., Converter={StaticResource Humanize}, x:DataType=x:Object}" />
                    <Label Text="Description" Style="{StaticResource FieldLabel}" />
                    <views:DescriptionEditor Text="{Binding Piece.Description}" IsEnabled="{Binding IsEditable}" />
                    <Label Text="Collections (comma-separated)" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding CollectionsText}" Placeholder="e.g. Birds, Summer 2026" />
                    <FlexLayout BindableLayout.ItemsSource="{Binding KnownCollections}" Wrap="Wrap" Margin="0,4,0,0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button Text="{Binding ., StringFormat='+ {0}'}" FontSize="12" Padding="8,2" Margin="0,0,6,6"
                                        Command="{Binding AddCollectionCommand, Source={x:Reference Root}, x:DataType=views:PieceDetailPage}"
                                        CommandParameter="{Binding .}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                    <Label Text="Tags (comma-separated)" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding TagsText}" Placeholder="e.g. goose, watercolor, pond" />
                    <Label Text="Created on" Style="{StaticResource FieldLabel}" />
                    <DatePicker Date="{Binding Piece.CreatedOn, Converter={StaticResource NullableDateOnly}}" HorizontalOptions="Start" />
                    <Label Text="Notes" Style="{StaticResource FieldLabel}" />
                    <Editor Text="{Binding Piece.Notes}" AutoSize="TextChanges" MinimumHeightRequest="80" Placeholder="Private notes" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" IsVisible="{Binding IsPiece}">
                    <Label Text="The original" Style="{StaticResource SectionTitle}" />
                    <HorizontalStackLayout Spacing="6">
                        <CheckBox IsChecked="{Binding Piece.Artwork.IsDigitalOnly}" VerticalOptions="Center" />
                        <Label Text="Digital only (no physical original)" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="Medium" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Piece.Artwork.Medium}" Placeholder="e.g. Watercolor on paper" />
                    <Label Text="Dimensions" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Piece.Artwork.Dimensions}" Placeholder="e.g. 30 × 40 cm" />
                    <Label Text="Status of the original" Style="{StaticResource FieldLabel}" />
                    <Picker ItemsSource="{x:Static vm:PieceDetailViewModel.OriginalStatuses}" SelectedItem="{Binding Piece.Artwork.OriginalStatus}"
                            ItemDisplayBinding="{Binding ., Converter={StaticResource Humanize}, x:DataType=x:Object}" />
                    <Label Text="{Binding Currency, StringFormat='Price of the original ({0})'}" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Piece.Artwork.OriginalPrice, Converter={StaticResource NullableDecimal}}" Keyboard="Numeric" Placeholder="Not for sale / unknown" />
                    <Label Text="Sold to" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Piece.Artwork.SoldTo}" />
                    <Label Text="Sold on" Style="{StaticResource FieldLabel}" />
                    <DatePicker Date="{Binding Piece.Artwork.SoldOn, Converter={StaticResource NullableDateOnly}}" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <!-- ============ PIECES (projects) ============ -->
        <ScrollView Grid.Row="3" IsVisible="{Binding IsPieces}">
            <VerticalStackLayout Spacing="8" Padding="0,0,0,24">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Text="{Binding ProjectPiecesSummary}" Style="{StaticResource Muted}" VerticalOptions="Center" />
                    <HorizontalStackLayout Grid.Column="1" Spacing="8">
                        <Button Text="Add existing piece…" Command="{Binding AddExistingPieceCommand}" />
                        <Button Text="New planned piece" Command="{Binding NewPlannedPieceCommand}" />
                        <Button Text="New piece" Command="{Binding NewChildPieceCommand}" Style="{StaticResource TabButtonSelected}" />
                    </HorizontalStackLayout>
                </Grid>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding ProjectPieces}" Spacing="6">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProjectPieceRow">
                            <Border Style="{StaticResource Card}" Padding="8">
                                <Grid ColumnDefinitions="36,64,*,Auto" ColumnSpacing="12">
                                    <Label Text="{Binding Position}" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" HorizontalTextAlignment="Center" Style="{StaticResource Muted}" />
                                    <Border Grid.Column="1" Style="{StaticResource Thumb}" HeightRequest="64" WidthRequest="64">
                                        <Image Source="{Binding Thumbnail}" Aspect="AspectFill" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                                        <Label Text="{Binding Title}" FontAttributes="Bold" />
                                        <Label Text="{Binding StatusText}" Style="{StaticResource Muted}" />
                                    </VerticalStackLayout>
                                    <HorizontalStackLayout Grid.Column="3" Spacing="6" VerticalOptions="Center">
                                        <Button Text="↑" Command="{Binding MoveUpCommand, Source={RelativeSource AncestorType={x:Type vm:PieceDetailViewModel}}, x:DataType=vm:PieceDetailViewModel}" CommandParameter="{Binding .}" />
                                        <Button Text="↓" Command="{Binding MoveDownCommand, Source={RelativeSource AncestorType={x:Type vm:PieceDetailViewModel}}, x:DataType=vm:PieceDetailViewModel}" CommandParameter="{Binding .}" />
                                        <Button Text="Open" Command="{Binding OpenChildCommand, Source={RelativeSource AncestorType={x:Type vm:PieceDetailViewModel}}, x:DataType=vm:PieceDetailViewModel}" CommandParameter="{Binding .}" />
                                        <Button Text="Move out" Command="{Binding RemoveFromProjectCommand, Source={RelativeSource AncestorType={x:Type vm:PieceDetailViewModel}}, x:DataType=vm:PieceDetailViewModel}" CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ============ FILES ============ -->
        <ScrollView Grid.Row="3" IsVisible="{Binding IsFiles}">
            <VerticalStackLayout Spacing="8" Padding="0,0,0,24">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Files are named {Art_Piece_Name}-{version}.{ext}. Changing a version renames the file on disk. You can also drop files here (Windows)."
                           Style="{StaticResource Muted}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Add files…" Command="{Binding AddFilesCommand}" />
                </Grid>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Files}" Spacing="8">
                    <BindableLayout.EmptyView>
                        <Label Text="No files yet. Add the photo of the artwork, the edited master, transparent versions…" Style="{StaticResource Muted}" Margin="0,12" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileRowViewModel">
                            <Border Style="{StaticResource Card}" Padding="8">
                                <Grid ColumnDefinitions="64,*,160,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                                    <Border Style="{StaticResource Thumb}" HeightRequest="64" WidthRequest="64">
                                        <Image Source="{Binding Thumbnail}" Aspect="AspectFill" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Entry.FileName}" FontAttributes="Bold" LineBreakMode="MiddleTruncation" />
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="Version" VerticalOptions="Center" Style="{StaticResource Muted}" />
                                            <Entry Text="{Binding EditVersion}" WidthRequest="200" />
                                            <Button Text="Rename" IsVisible="{Binding VersionChanged}"
                                                    Command="{Binding RenameVersionCommand, Source={x:Reference Root}, x:DataType=views:PieceDetailPage}" CommandParameter="{Binding .}" />
                                            <Label Text="{Binding SizeText}" Style="{StaticResource Muted}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding MissingText}" Style="{StaticResource WarningText}" IsVisible="{Binding IsMissing}" />
                                        <HorizontalStackLayout Spacing="6" IsVisible="{Binding IsMisnamed}">
                                            <Label Text="⚠ Doesn't follow the naming convention" Style="{StaticResource WarningText}" VerticalOptions="Center" />
                                            <Button Text="Fix name" FontSize="12" Padding="8,2"
                                                    Command="{Binding ApplyConventionCommand, Source={x:Reference Root}, x:DataType=views:PieceDetailPage}" CommandParameter="{Binding .}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                                        <Label Text="Kind" Style="{StaticResource FieldLabel}" Margin="0" />
                                        <Picker ItemsSource="{Binding FileKinds, Source={RelativeSource AncestorType={x:Type vm:PieceDetailViewModel}}, x:DataType=vm:PieceDetailViewModel}" SelectedItem="{Binding Entry.Kind, Converter={StaticResource KeepValue}}"
                                                ItemDisplayBinding="{Binding ., Converter={StaticResource Humanize}, x:DataType=x:Object}" />
                                    </VerticalStackLayout>
                                    <HorizontalStackLayout Grid.Column="3" Spacing="6" VerticalOptions="Center">
                                        <Button Text="Open" Command="{Binding OpenFileCommand, Source={x:Reference Root}, x:DataType=views:PieceDetailPage}" CommandParameter="{Binding .}" />
                                        <Button Text="Show" Command="{Binding RevealFileCommand, Source={x:Reference Root}, x:DataType=views:PieceDetailPage}" CommandParameter="{Binding .}" />
                                        <Button Text="Remove" Command="{Binding UntrackFileCommand, Source={x:Reference Root}, x:DataType=views:PieceDetailPage}" CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>

                                    <!-- Protection against AI training (Mistcoat) -->
                                    <views:ProtectControls Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                        QuickProtectCommand="{Binding QuickProtectCommand, Source={x:Reference Root}, x:DataType=views:PieceDetailPage}"
                                        ShowOptionsCommand="{Binding ShowProtectOptionsCommand, Source={x:Reference Root}, x:DataType=views:PieceDetailPage}"
                                        ProtectWithOptionsCommand="{Binding ProtectWithOptionsCommand, Source={x:Reference Root}, x:DataType=views:PieceDetailPage}"
                                        CancelCommand="{Binding CancelProtectCommand, Source={x:Reference Root}, x:DataType=views:PieceDetailPage}"
                                        OpenInMistcoatCommand="{Binding OpenInMistcoatCommand, Source={x:Reference Root}, x:DataType=views:PieceDetailPage}"
                                        OpenCopyCommand="{Binding OpenProtectedCopyCommand, Source={x:Reference Root}, x:DataType=views:PieceDetailPage}"
                                        ShowCopyCommand="{Binding ShowProtectedCopyCommand, Source={x:Reference Root}, x:DataType=views:PieceDetailPage}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- The original photographs (Photograph folder) -->
                <Label Text="Photograph" Style="{StaticResource SectionTitle}" IsVisible="{Binding HasPhotographs}" />
                <Label Text="The original photographs of the artwork, in the Photograph folder of this piece ({Art_Piece_Name}-photograph.{ext})."
                       Style="{StaticResource Muted}" IsVisible="{Binding HasPhotographs}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Photographs}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:SpecialFileRow">
                            <Border Style="{StaticResource Card}" Padding="8">
                                <Grid ColumnDefinitions="64,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                                    <Border Style="{StaticResource Thumb}" HeightRequest="64" WidthRequest="64">
                                        <Image Source="{Binding Thumbnail}" Aspect="AspectFill" />
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding FileName, StringFormat='Photograph/{0}'}" FontAttributes="Bold" VerticalOptions="Center" LineBreakMode="MiddleTruncation" />
                                    <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                        <Button Text="Open" Command="{Binding OpenPhotographCommand, Source={x:Reference Root}, x:DataType=views:PieceDetailPage}" CommandParameter="{Binding .}" />
                                        <Button Text="Show" Command="{Binding ShowPhotographCommand, Source={x:Reference Root}, x:DataType=views:PieceDetailPage}" CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                    <views:ProtectControls Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                        QuickProtectCommand="{Binding QuickProtectCommand, Source={x:Reference Root}, x:DataType=views:PieceDetailPage}"
                                        ShowOptionsCommand="{Binding ShowProtectOptionsCommand, Source={x:Reference Root}, x:DataType=views:PieceDetailPage}"
                                        ProtectWithOptionsCommand="{Binding ProtectWithOptionsCommand, Source={x:Reference Root}, x:DataType=views:PieceDetailPage}"
                                        CancelCommand="{Binding CancelProtectCommand, Source={x:Reference Root}, x:DataType=views:PieceDetailPage}"
                                        OpenInMistcoatCommand="{Binding OpenInMistcoatCommand, Source={x:Reference Root}, x:DataType=views:PieceDetailPage}"
                                        OpenCopyCommand="{Binding OpenProtectedCopyCommand, Source={x:Reference Root}, x:DataType=views:PieceDetailPage}"
                                        ShowCopyCommand="{Binding ShowProtectedCopyCommand, Source={x:Reference Root}, x:DataType=views:PieceDetailPage}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="New files found in the folder" Style="{StaticResource SectionTitle}" IsVisible="{Binding Untracked.Count, Converter={StaticResource HasValue}}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Untracked}" Spacing="6">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:UntrackedFileViewModel">
                            <Border Style="{StaticResource Banner}">
                                <Grid ColumnDefinitions="*,200,160,Auto" ColumnSpacing="10">
                                    <Label Text="{Binding FileName}" VerticalOptions="Center" LineBreakMode="MiddleTruncation" />
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="Version (empty = cover)" Style="{StaticResource FieldLabel}" Margin="0" />
                                        <Entry Text="{Binding Version}" Placeholder="e.g. master, transparent" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2">
                                        <Label Text="Kind" Style="{StaticResource FieldLabel}" Margin="0" />
                                        <Picker ItemsSource="{Binding FileKinds, Source={RelativeSource AncestorType={x:Type vm:PieceDetailViewModel}}, x:DataType=vm:PieceDetailViewModel}" SelectedItem="{Binding Kind, Converter={StaticResource KeepValue}}"
                                                ItemDisplayBinding="{Binding ., Converter={StaticResource Humanize}, x:DataType=x:Object}" />
                                    </VerticalStackLayout>
                                    <HorizontalStackLayout Grid.Column="3" Spacing="6" VerticalOptions="End">
                                        <Button Text="Track &amp; rename" Command="{Binding TrackFileCommand, Source={x:Reference Root}, x:DataType=views:PieceDetailPage}" CommandParameter="{Binding .}" />
                                        <Button Text="Track as is" Command="{Binding TrackFileAsIsCommand, Source={x:Reference Root}, x:DataType=views:PieceDetailPage}" CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ============ PRODUCTS ============ -->
        <ScrollView Grid.Row="3" IsVisible="{Binding IsProducts}">
            <VerticalStackLayout Spacing="10" Padding="0,0,0,24" MaximumWidthRequest="900" HorizontalOptions="Start">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Text="Products are what you sell: Printify products, things you make and ship yourselves, the original… A product can show several art pieces, and an art piece can be in many products."
                           Style="{StaticResource Muted}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="New product" Command="{Binding NewProductCommand}" />
                </Grid>
                <Label Text="Link an existing product to this art piece" Style="{StaticResource FieldLabel}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Picker Title="Choose a product…" ItemsSource="{Binding AvailableProducts}" SelectedItem="{Binding SelectedAvailableProduct}"
                            ItemDisplayBinding="{Binding Name, x:DataType=m:Product}" />
                    <Button Grid.Column="1" Text="Link" Command="{Binding LinkProductCommand}" />
                </Grid>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding LinkedProducts}" Spacing="6">
                    <BindableLayout.EmptyView>
                        <Label Text="No products yet." Style="{StaticResource Muted}" Margin="0,12" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:LinkedProductRow">
                            <Border Style="{StaticResource Card}" Padding="12,8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenProductCommand, Source={RelativeSource AncestorType={x:Type vm:PieceDetailViewModel}}, x:DataType=vm:PieceDetailViewModel}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" />
                                        <Label Text="{Binding Details}" Style="{StaticResource Muted}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding Channels}" VerticalOptions="Center" Style="{StaticResource Muted}" />
                                    <Button Grid.Column="2" Text="Open" Command="{Binding OpenProductCommand, Source={RelativeSource AncestorType={x:Type vm:PieceDetailViewModel}}, x:DataType=vm:PieceDetailViewModel}" CommandParameter="{Binding .}" />
                                    <Button Grid.Column="3" Text="Unlink" Command="{Binding UnlinkProductCommand, Source={RelativeSource AncestorType={x:Type vm:PieceDetailViewModel}}, x:DataType=vm:PieceDetailViewModel}" CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="Product pictures" Style="{StaticResource SectionTitle}" IsVisible="{Binding HasProductPictures}" />
                <Label Text="Pictures of products that show this art piece (on a project: also those of its pieces). Click one to open its product."
                       Style="{StaticResource Muted}" IsVisible="{Binding HasProductPictures}" />
                <FlexLayout BindableLayout.ItemsSource="{Binding ProductPictures}" Wrap="Wrap" Direction="Row" JustifyContent="Start" IsVisible="{Binding HasProductPictures}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProductPictureTile">
                            <Border Style="{StaticResource Card}" Padding="6" Margin="0,0,8,8" WidthRequest="170">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenProductPictureCommand, Source={RelativeSource AncestorType={x:Type vm:PieceDetailViewModel}}, x:DataType=vm:PieceDetailViewModel}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="2">
                                    <Border Style="{StaticResource Thumb}" HeightRequest="140">
                                        <Image Source="{Binding Thumbnail}" Aspect="AspectFit" />
                                    </Border>
                                    <Label Text="{Binding ProductName}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Caption}" Style="{StaticResource Muted}" FontSize="12" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ============ SALES ============ -->
        <ScrollView Grid.Row="3" IsVisible="{Binding IsSales}">
            <VerticalStackLayout Spacing="8" Padding="0,0,0,24" MaximumWidthRequest="900" HorizontalOptions="Start">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Text="{Binding SalesSummary}" VerticalOptions="Center" FontAttributes="Bold" />
                    <Button Grid.Column="1" Text="Recalculate" Command="{Binding RefreshSalesSummaryCommand}" />
                </Grid>
                <Label Text="Everything sold that shows this art piece. Sales are recorded on orders (Orders page), or imported from Shopify and Printify." Style="{StaticResource Muted}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sales}" Spacing="6">
                    <BindableLayout.EmptyView>
                        <Label Text="No sales yet." Style="{StaticResource Muted}" Margin="0,12" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="s:SaleRow">
                            <Border Style="{StaticResource Card}" Padding="10,6">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenOrderCommand, Source={RelativeSource AncestorType={x:Type vm:PieceDetailViewModel}}, x:DataType=vm:PieceDetailViewModel}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="100,110,*,50,90,90" ColumnSpacing="8">
                                    <Label Text="{Binding Date, StringFormat='{0:d}'}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Order.OrderRef}" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding ProductName}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="3" Text="{Binding Line.Quantity}" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                    <Label Grid.Column="4" Text="{Binding Revenue, StringFormat='{0:N2}'}" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                    <Label Grid.Column="5" Text="{Binding Profit, StringFormat='{0:N2}'}" HorizontalTextAlignment="End" VerticalOptions="Center" FontAttributes="Bold" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ============ COPYRIGHT ============ -->
        <ScrollView Grid.Row="3" IsVisible="{Binding IsCopyright}">
            <VerticalStackLayout MaximumWidthRequest="640" HorizontalOptions="Start" Padding="0,0,0,24">
                <Label Text="Copyright" Style="{StaticResource SectionTitle}" />
                <Label Text="Owner" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding Piece.Copyright.Owner}" />
                <Label Text="Year" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding Piece.Copyright.Year, Converter={StaticResource NullableInt}}" Keyboard="Numeric" WidthRequest="120" HorizontalOptions="Start" />
                <Label Text="Registration status" Style="{StaticResource FieldLabel}" />
                <Picker ItemsSource="{x:Static vm:PieceDetailViewModel.CopyrightStatuses}" SelectedItem="{Binding Piece.Copyright.Status}"
                        ItemDisplayBinding="{Binding ., Converter={StaticResource Humanize}, x:DataType=x:Object}" WidthRequest="240" HorizontalOptions="Start" />
                <Label Text="Registration number" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding Piece.Copyright.RegistrationNumber}" />
                <Label Text="Registered on" Style="{StaticResource FieldLabel}" />
                <DatePicker Date="{Binding Piece.Copyright.RegisteredOn, Converter={StaticResource NullableDateOnly}}" HorizontalOptions="Start" />
                <Label Text="Office / registry" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding Piece.Copyright.Office}" Placeholder="e.g. a copyright office, i-DEPOT, a registration service" />
                <Label Text="Notes" Style="{StaticResource FieldLabel}" />
                <Editor Text="{Binding Piece.Copyright.Notes}" AutoSize="TextChanges" MinimumHeightRequest="80" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
