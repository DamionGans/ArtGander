<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ArtGander.App.ViewModels"
             x:Class="ArtGander.App.Views.LibraryPage"
             Shell.NavBarIsVisible="False"
             x:DataType="vm:LibraryViewModel"
             Title="Library">

    <ContentPage.MenuBarItems>
        <MenuBarItem Text="File">
            <MenuFlyoutItem Text="New Art Piece…" Command="{Binding NewPieceCommand}">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="{OnPlatform WinUI=Ctrl, MacCatalyst=Cmd}" Key="N" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Refresh" Command="{Binding RefreshCommand}">
                <MenuFlyoutItem.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="{OnPlatform WinUI=Ctrl, MacCatalyst=Cmd}" Key="R" />
                </MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Choose Art Folder…" Command="{Binding ChooseFolderCommand}" />
        </MenuBarItem>
    </ContentPage.MenuBarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="24,16,24,0" RowSpacing="12">

        <!-- Header and toolbar -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout VerticalOptions="Center">
                <Label Text="Library" Style="{StaticResource PageTitle}" />
                <Label Text="{Binding Summary}" Style="{StaticResource Muted}" />
            </VerticalStackLayout>
            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                <ActivityIndicator IsRunning="{Binding IsScanning}" IsVisible="{Binding IsScanning}" HeightRequest="20" WidthRequest="20" />
                <Button Text="{Binding IsSelecting, Converter={StaticResource SelectLabel}}" Command="{Binding ToggleSelectingCommand}" IsVisible="{Binding HasRoot}" />
                <Button Text="Refresh" Command="{Binding RefreshCommand}" />
                <Button Text="New…" Command="{Binding NewPieceCommand}" />
            </HorizontalStackLayout>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,170,200,150,Auto" ColumnSpacing="12" IsVisible="{Binding HasRoot}">
            <SearchBar Placeholder="Search titles, descriptions, tags, products… (also inside projects)" Text="{Binding SearchText}" />
            <Picker Grid.Column="1" ItemsSource="{x:Static vm:LibraryViewModel.TypeFilters}" SelectedItem="{Binding TypeFilter}" />
            <Picker Grid.Column="2" ItemsSource="{Binding CollectionFilters}" SelectedItem="{Binding SelectedCollection}" />
            <Picker Grid.Column="3" ItemsSource="{x:Static vm:LibraryViewModel.TileShapes}" SelectedItem="{Binding TileShape}" />
            <HorizontalStackLayout Grid.Column="4" Spacing="4" VerticalOptions="Center">
                <CheckBox IsChecked="{Binding AttentionOnly}" VerticalOptions="Center" />
                <Label Text="Needs attention" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Grid>

        <!-- Selection actions -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,8" IsVisible="{Binding IsSelecting}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Text="{Binding SelectionText}" VerticalOptions="Center" FontAttributes="Bold" />
                <HorizontalStackLayout Grid.Column="1" Spacing="8">
                    <Button Text="Select all / none" Command="{Binding SelectAllCommand}" />
                    <Button Text="{Binding TrackSelectedText}" Command="{Binding TrackSelectedCommand}" IsVisible="{Binding CanTrackSelected}" />
                    <Button Text="{Binding MakeProjectText}" Command="{Binding MakeProjectCommand}" IsVisible="{Binding CanGroupSelected}" />
                    <Button Text="{Binding MoveToProjectText}" Command="{Binding MoveToProjectCommand}" IsVisible="{Binding CanGroupSelected}" />
                    <Button Text="{Binding AddSelectedText}" Command="{Binding AddSelectedToCollectionCommand}" IsVisible="{Binding CanAddSelectedToCollection}"
                            Style="{StaticResource TabButtonSelected}" />
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="3">
            <!-- No folder chosen yet -->
            <VerticalStackLayout IsVisible="{Binding HasRoot, Converter={StaticResource Not}}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="12" MaximumWidthRequest="460">
                <Image Source="placeholder.png" HeightRequest="96" WidthRequest="96" />
                <Label Text="Welcome to ArtGander" FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                <Label Text="Choose the folder where your art lives. It can be on this computer or on a network drive shared with your other computers. Each art piece gets its own subfolder there."
                       HorizontalTextAlignment="Center" Style="{StaticResource Muted}" />
                <Button Text="Choose art folder…" Command="{Binding ChooseFolderCommand}" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Empty library -->
            <VerticalStackLayout IsVisible="{Binding IsEmpty}" VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                <Label Text="Nothing here yet. The goose is still on the loose." FontSize="18" HorizontalTextAlignment="Center" />
                <Button Text="Create your first art piece" Command="{Binding NewPieceCommand}" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Label IsVisible="{Binding NoMatches}" Text="Nothing matches your filters." Style="{StaticResource Muted}" HorizontalOptions="Center" Margin="0,40" />

            <CollectionView x:Name="Grid" ItemsSource="{Binding Items}" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="5" HorizontalItemSpacing="14" VerticalItemSpacing="14" />
                </CollectionView.ItemsLayout>
                <CollectionView.Footer>
                    <BoxView HeightRequest="24" Color="Transparent" />
                </CollectionView.Footer>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PieceItemViewModel">
                        <!-- A tile in the chosen shape: the artwork fills it, the title sits on a dark band at the bottom.
                             Projects look like a small stack of cards. -->
                        <Grid HeightRequest="{Binding TileHeight, Source={RelativeSource AncestorType={x:Type vm:LibraryViewModel}}, x:DataType=vm:LibraryViewModel}">
                        <Border Style="{StaticResource Thumb}" StrokeShape="RoundRectangle 8" IsVisible="{Binding IsProject}" Margin="10,0,0,10" Opacity="0.45" InputTransparent="True" />
                        <Border Style="{StaticResource Thumb}" StrokeShape="RoundRectangle 8" IsVisible="{Binding IsProject}" Margin="5,5,5,5" Opacity="0.7" InputTransparent="True" />
                        <Border Style="{StaticResource Thumb}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsProject}" Value="True">
                                    <Setter Property="Margin" Value="0,10,10,0" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource Beak}" />
                                    <Setter Property="StrokeThickness" Value="4" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:LibraryViewModel}}, x:DataType=vm:LibraryViewModel}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid>
                                <Image Source="placeholder.png" Aspect="AspectFit" Opacity="0.5" Margin="48" />
                                <Image Source="{Binding Thumbnail}" Aspect="AspectFill" />

                                <!-- Selection check -->
                                <Border IsVisible="{Binding IsSelecting}" BackgroundColor="#B0000000" StrokeThickness="0" StrokeShape="RoundRectangle 6"
                                        HorizontalOptions="Start" VerticalOptions="Start" Margin="8" Padding="4,0" InputTransparent="True">
                                    <Label Text="{Binding IsSelected, Converter={StaticResource CheckMark}}" TextColor="White" FontSize="18" />
                                </Border>

                                <!-- Attention badge -->
                                <Border IsVisible="{Binding AttentionText, Converter={StaticResource HasValue}}" BackgroundColor="#E0B7791F" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10" HorizontalOptions="End" VerticalOptions="Start" Margin="8" Padding="8,2" InputTransparent="True">
                                    <Label Text="{Binding AttentionText}" TextColor="White" FontSize="11" />
                                </Border>

                                <!-- Title band -->
                                <Grid VerticalOptions="End" BackgroundColor="#B8000000" Padding="10,6" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" InputTransparent="True">
                                    <Label Text="{Binding Badge}" TextColor="{StaticResource Beak}" FontSize="10" FontAttributes="Bold" IsVisible="{Binding Badge, Converter={StaticResource HasValue}}" />
                                    <Label Grid.Row="1" Text="{Binding Title}" TextColor="White" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding StatusText}" TextColor="#DDDDDD" FontSize="11" VerticalOptions="Center" />
                                    <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Subtitle}" TextColor="#DDDDDD" FontSize="11" LineBreakMode="TailTruncation" />
                                </Grid>
                            </Grid>
                        </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
