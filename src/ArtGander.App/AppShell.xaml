<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:ArtGander.App.Views"
       xmlns:local="clr-namespace:ArtGander.App"
       x:Class="ArtGander.App.AppShell"
       x:Name="ShellRoot"
       Title="ArtGander"
       FlyoutBehavior="Locked"
       FlyoutWidth="200">

    <Shell.FlyoutHeader>
        <VerticalStackLayout Padding="16,20,16,12" Spacing="2">
            <Label Text="ArtGander" FontSize="20" FontAttributes="Bold" />
            <Label Text="Artistic Goose On The Loose" Style="{StaticResource Muted}" FontSize="11" />
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <!-- The menu: plain buttons, so a click always navigates, also on the page you're already in
         (e.g. Library while an art piece is open goes back to the Library). -->
    <Shell.FlyoutContent>
        <VerticalStackLayout x:Name="Menu" Padding="{OnPlatform WinUI='4,0', MacCatalyst='10,0'}" Spacing="{OnPlatform WinUI=2, MacCatalyst=1}" BindableLayout.ItemsSource="{Binding MenuEntries, Source={x:Reference ShellRoot}, x:DataType=local:AppShell}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="local:MenuEntry">
                    <!-- Looks like the system sidebar: left-aligned text, a hover highlight, and the selected page marked
                         with a subtle background and accent bar (Windows) or a rounded accent background (macOS). -->
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 5" BackgroundColor="Transparent"
                            HeightRequest="{OnPlatform WinUI=36, MacCatalyst=28}" Padding="{OnPlatform WinUI='8,0', MacCatalyst='10,0'}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateCommand, Source={x:Reference ShellRoot}, x:DataType=local:AppShell}" CommandParameter="{Binding Route}" />
                        </Border.GestureRecognizers>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#0A000000, Dark=#0FFFFFFF}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="BackgroundColor" Value="{OnPlatform WinUI={AppThemeBinding Light=#0F000000, Dark=#15FFFFFF}, MacCatalyst={StaticResource Pond}}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{OnPlatform WinUI=10, MacCatalyst=0}">
                            <!-- Windows: the small accent bar of a selected navigation item -->
                            <BoxView WidthRequest="{OnPlatform WinUI=3, MacCatalyst=0}" HeightRequest="16" CornerRadius="2" Color="{StaticResource Pond}"
                                     VerticalOptions="Center" Opacity="0">
                                <BoxView.Triggers>
                                    <DataTrigger TargetType="BoxView" Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="Opacity" Value="{OnPlatform WinUI=1, MacCatalyst=0}" />
                                    </DataTrigger>
                                </BoxView.Triggers>
                            </BoxView>
                            <Label Grid.Column="1" Text="{Binding Title}" VerticalOptions="Center" HorizontalOptions="Start" HorizontalTextAlignment="Start"
                                   FontSize="{OnPlatform WinUI=14, MacCatalyst=13}" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#F0F0F0}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="TextColor" Value="{OnPlatform WinUI={AppThemeBinding Light=#1A1A1A, Dark=#F0F0F0}, MacCatalyst=White}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </Shell.FlyoutContent>

    <FlyoutItem Title="Library">
        <ShellContent Route="library" ContentTemplate="{DataTemplate views:LibraryPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Products">
        <ShellContent Route="products" ContentTemplate="{DataTemplate views:ProductsPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Orders">
        <ShellContent Route="orders" ContentTemplate="{DataTemplate views:OrdersPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Shops">
        <ShellContent Route="shops" ContentTemplate="{DataTemplate views:ShopsPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Collections">
        <ShellContent Route="collections" ContentTemplate="{DataTemplate views:CollectionsPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Settings">
        <ShellContent Route="settings" ContentTemplate="{DataTemplate views:SettingsPage}" />
    </FlyoutItem>
</Shell>
